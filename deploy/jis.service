[Unit]
Description=Jordaan Infinite Sports
After=network.target

[Service]
WorkingDirectory=/opt/jis
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=DATA_DIR=/var/lib/jis
Environment=BETTER_AUTH_URL=https://example.co.za
Environment=SHOP_ORIGINS=https://example.co.za,https://www.example.co.za
EnvironmentFile=-/opt/jis/.env
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
